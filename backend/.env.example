# ---------------------------------------------------------------------------
# .env.example  —  PLACEHOLDER for future phases only.
#
# Phase 0 reads NO environment variables and loads NO configuration. Nothing in
# the domain layer depends on these keys. They are listed here (commented out)
# purely to document what LATER phases are expected to need. Copy this file to
# `.env` and fill in real values only once a phase that consumes them exists.
#
# Do NOT put real secrets in this file. Do NOT commit a populated `.env`.
# ---------------------------------------------------------------------------

# --- LLM provider (Phase 1+, OpenAI-compatible) ---
# LLM_API_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# --- Web / research tools (Phase 1+) ---
# SEARCH_API_KEY=

# --- Persistence for async jobs (Phase 1+) ---
# DATABASE_URL=

# --- API server (Phase 1+) ---
# APP_HOST=0.0.0.0
# APP_PORT=8000
