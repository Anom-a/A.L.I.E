# ---------------------------------------------------------------------------
# .env.example — placeholders only. Copy to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed. Real environment
# variables always win over the file, so deployments can just export them.
# Only infrastructure/config.py reads these; adapters receive values through
# their constructors.
# ---------------------------------------------------------------------------

# --- LLM: any OpenAI-compatible endpoint -----------------------------------
# The provider is not hardcoded. Point OPENAI_BASE_URL at OpenAI, OpenRouter,
# Groq, Together, or a local vLLM/Ollama/llama.cpp server and set the matching
# model. Leave OPENAI_BASE_URL empty to use the OpenAI client's own default.
OPENAI_API_KEY=your-llm-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_PLANNER=your-model-name-here

# --- Web search ------------------------------------------------------------
TAVILY_API_KEY=your-tavily-api-key-here

# --- iFixit ----------------------------------------------------------------
# Base URL for the iFixit public API (v2.0). No API key is required.
IFIXIT_API_BASE=https://www.ifixit.com/api/2.0

# --- Shared HTTP settings --------------------------------------------------
# Upper bound, in seconds, for a single outbound request.
REQUEST_TIMEOUT_SECONDS=20

# --- Planner ---------------------------------------------------------------
# Upper bound on how many sub-questions one research topic is decomposed into.
# Optional; omit to use the built-in default of 5.
MAX_SUBQUESTIONS=5

